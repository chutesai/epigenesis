# Whitelist: only the public file set is tracked. Everything else (scratch runs, unlinked figures,
# review transcripts, caches) stays local. To publish a new file, add an explicit "!" line below.
/*

!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/ROADMAP.md



!/paper/
/paper/*
!/paper/freeslot.tex
!/paper/refs.bib
!/paper/freeslot.pdf

# figures linked from the README / paper, and the scripts that regenerate them
!/figures/
/figures/*
!/figures/epigenetic-llm.jpg
!/figures/freeslot_html_render.png
!/figures/make_e2e_figs.py
!/figures/fig_e2e_frontier.png
!/figures/fig_e2e_frontier.pdf
!/figures/fig_e2e_storage.png
!/figures/fig_e2e_storage.pdf
!/figures/fig_chaos_floor.png
!/figures/fig_chaos_floor.pdf
!/figures/fig_e2e_trajectory.png
!/figures/fig_e2e_trajectory.pdf

!/experiments/
/experiments/*

# real lambda experts: findings, harness, decoder, the linked controlled-Pareto figure and its data
!/experiments/real_lambda/
/experiments/real_lambda/*
!/experiments/real_lambda/FINDINGS.md
!/experiments/real_lambda/real_fsa.py
!/experiments/real_lambda/decode_dump.py
!/experiments/real_lambda/make_pareto2_fig.py
!/experiments/real_lambda/fig_controlled_pareto.png
!/experiments/real_lambda/pz_*.json

# end-to-end living-model experiments on the full 8B
!/experiments/end_to_end/
/experiments/end_to_end/*
!/experiments/end_to_end/E2E_FINDINGS.md
!/experiments/end_to_end/e2e_fsa.py
!/experiments/end_to_end/data/
/experiments/end_to_end/data/*
!/experiments/end_to_end/data/v6_lora_L1415_loc100.json
!/experiments/end_to_end/data/v6_lora_L1415_noreg.json
!/experiments/end_to_end/data/v6_lora_L28dn_loc100.json
!/experiments/end_to_end/data/v7_fsa_all_bop_t07.json
!/experiments/end_to_end/data/v7_fsa_all_bop_t09.json
!/experiments/end_to_end/data/v6_fsa_all_wd03.json
!/experiments/end_to_end/data/v6_fsa_all_wd01.json
!/experiments/end_to_end/data/v7_fsa_all_wd03_block.json
!/experiments/end_to_end/data/v6_fsa_L28_netcost.json
!/experiments/end_to_end/data/v7_fsa_all_fp4_loc10_aug.json
!/experiments/end_to_end/data/v6_fsa_L28_bf16.json
!/experiments/end_to_end/data/floor_diag.json
!/experiments/end_to_end/data/eps_diag.txt

# never, anywhere
__pycache__/
*.py[cod]
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
*.aux
*.log
*.out
*.synctex.gz

ROADMAP.md

# EP-1 epigenesis harness (synthetic user, self-study, consolidation, evaluation); outputs stay local
!/experiments/epigenesis/
/experiments/epigenesis/*
!/experiments/epigenesis/DESIGN.md
!/experiments/epigenesis/EP1_PREREG.md
!/experiments/epigenesis/epi_common.py
!/experiments/epigenesis/epi_gpu.py
!/experiments/epigenesis/make_user.py
!/experiments/epigenesis/selfstudy.py
!/experiments/epigenesis/consolidate.py
!/experiments/epigenesis/evaluate.py
!/experiments/epigenesis/run_ep1.sh
!/experiments/epigenesis/tests/
/experiments/epigenesis/tests/*
!/experiments/epigenesis/tests/*.py
